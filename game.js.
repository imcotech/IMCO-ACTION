console.log("IMCO Action Engine Initialized.");

document.addEventListener("DOMContentLoaded", function () {
    // ربط وتفعيل أزرار بدء المعركة والجلسة التوليدية
    const startButtons = document.querySelectorAll("button");
    
    startButtons.forEach(function(btn) {
        btn.addEventListener("click", function () {
            const btnText = this.innerText.trim();
            if (btnText.includes("ابدأ")) {
                startActionEngine(btnText);
            } else if (btnText.includes("إنهاء") || btnText.includes("تحليلات")) {
                endSessionAnalysis();
            }
        });
    });
});

function startActionEngine(mode) {
    console.log("Starting engine mode: " + mode);
    alert("تم بدء المعركة التوليدية بنجاح! جاري تشغيل المحرك ثلاثي الأبعاد والجزيرة التفاعلية...");
    
    // محاكاة تشغيل الشاشة السوداء والمحرك
    const canvases = document.querySelectorAll("canvas, div[style*='background: black'], .canvas-container");
    canvases.forEach(function(el) {
        el.style.border = "2px solid #00ff66";
    });
}

function triggerRandomEvent() {
    alert("تم إطلاق حدث عشوائي توليدي ديناميكي جديد بنجاح!");
}

function endSessionAnalysis() {
    alert("تم إنهاء الجلسة. جاري استعراض إحصاءات الأداء والتحليلات النهائية...");
}
