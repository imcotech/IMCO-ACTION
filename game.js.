// تهيئة محرك PlayCanvas الرسومي والصوتي
const canvas = document.getElementById('application-canvas');
const app = new pc.Application(canvas, {
    mouseInput: new pc.MouseInput(canvas),
    touchInput: new pc.TouchInput(canvas)
});
app.setCanvasFillMode(pc.FILLMODE_FILL_WINDOW);
app.setCanvasResolution(pc.RESOLUTION_AUTO);

// نظام المؤثرات الصوتية التفاعلية عبر Web Audio API
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSoundEffect(type) {
    if (audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
    const osc = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    osc.connect(gainNode);
    gainNode.connect(audioCtx.destination);

    if (type === 'start') {
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.3);
        gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.3);
    } else if (type === 'event') {
        osc.frequency.setValueAsValue ? osc.frequency.setValueAtTime(300, audioCtx.currentTime) : osc.frequency.setValueAtTime(300, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.4);
        gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.4);
    } else {
        osc.frequency.setValueAtTime(600, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(300, audioCtx.currentTime + 0.2);
        gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.2);
    }
}

// حركة مشهد الجزيرة التوليدي ثلاثي الأبعاد مع مؤثرات بصرية
app.on('update', function (dt) {
    if (window.islandEntity) {
        window.islandEntity.rotate(0, 15 * dt, 5 * dt);
    }
});

function init3DWorld() {
    const camera = new pc.Entity();
    camera.addComponent("camera", {
        clearColor: new pc.Color(0.03, 0.05, 0.08)
    });
    camera.setLocalPosition(0, 4, 8);
    camera.lookAt(0, 0, 0);
    app.root.addChild(camera);

    const light = new pc.Entity();
    light.addComponent("light", {
        type: "directional",
        color: new pc.Color(1, 0.9, 0.8),
        intensity: 2.0
    });
    light.setLocalEulerAngles(50, 40, 0);
    app.root.addChild(light);

    // نموذج الجزيرة/الساحة ثلاثية الأبعاد
    const island = new pc.Entity();
    island.addComponent("render", {
        type: "box"
    });
    island.setLocalScale(3.5, 0.6, 3.5);
    app.root.addChild(island);
    window.islandEntity = island;

    app.start();
}

init3DWorld();

