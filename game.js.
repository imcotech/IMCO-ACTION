document.addEventListener("DOMContentLoaded", function () {
    console.log("IMCO Action Engine Initialized.");

    // تفعيل أزرار البدء في القسمين
    const buttons = document.querySelectorAll("button, .btn-success");
    buttons.forEach(function (btn) {
        btn.addEventListener("click", function () {
            alert("تم بدء المعركة بنجاح! جاري تحميل المحرك التوليدي...");
        });
    });
});

function triggerRandomEvent() {
    alert("تم إطلاق حدث عشوائي توليدي جديد بنجاح!");
}

function endSession() {
    alert("تم إنهاء الجلسة واستعراض تحليلات الأداء بنجاح.");
}
